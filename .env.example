# ---------- Required ----------
# PostgreSQL (local Docker, Supabase, Neon, Railway…). Supabase: use the "connection pooling" URI + ?pgbouncer=true for serverless.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/munich_jobs"

# NextAuth: public URL of the app and a random secret (openssl rand -base64 32)
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET=""

# 32-byte key for AES-256-GCM encryption of CVs and OAuth tokens:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Keep it safe: losing it makes stored CVs/tokens unreadable.
ENCRYPTION_KEY=""

# ---------- AI (CV analysis, match scoring, drafting) ----------
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-5-5"
AI_AUTO_SCORE_TOP=10          # best keyword matches auto-evaluated by AI after each search
HIGH_MATCH_THRESHOLD=75

# ---------- Gmail sending (Google OAuth) ----------
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ---------- Outlook sending (Microsoft Entra ID / Azure AD OAuth) ----------
AZURE_AD_CLIENT_ID=""
AZURE_AD_CLIENT_SECRET=""
AZURE_AD_TENANT_ID="common"   # "common" = personal + work accounts

# ---------- Optional job source ----------
# Adzuna (free key: https://developer.adzuna.com) – adds a large aggregator
ADZUNA_APP_ID=""
ADZUNA_APP_KEY=""

# ---------- Scheduled refresh ----------
# Any long random string. The scheduler must call GET /api/cron/refresh with
# "Authorization: Bearer <CRON_SECRET>" (Vercel Cron does this automatically).
CRON_SECRET=""

# ---------- Local development only ----------
ALLOW_DEV_LOGIN="false"
NEXT_PUBLIC_ALLOW_DEV_LOGIN="false"
LOG_LEVEL="info"
